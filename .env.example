# Copy to .env (or just run ./start.sh, which does this for you and fills in
# random secrets). .env is git-ignored. Never commit real credentials.

# --- Postgres (used by the bundled docker compose database) ---
POSTGRES_USER=crm
POSTGRES_DB=crm
# Use only letters and digits (it is embedded in a connection URL).
POSTGRES_PASSWORD=change-me-generate-a-long-random-value

# --- App ---
# Host port the CRM listens on (bound to 127.0.0.1 only).
APP_PORT=3000
# Used by scripts and `npm run dev` outside docker. Inside docker compose this
# is assembled from the POSTGRES_* values above.
DATABASE_URL=postgres://crm:change-me-generate-a-long-random-value@localhost:5432/crm
# IANA time zone used for "today" in the daily agenda.
APP_TIMEZONE=UTC
# Currency code used to display opportunity values.
CURRENCY=USD
# Set to true only when serving over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false

# --- First admin (created on first start when the users table is empty) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-chars

# --- Demo workspace ---
# true: seed a realistic demo workspace on first start (only if the database is empty).
SEED_DEMO=true
# Password for the demo users (alex@example.com member, sam@example.com viewer).
DEMO_USERS_PASSWORD=change-me-demo-password

# --- Backups (docker compose "backup" service) ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
